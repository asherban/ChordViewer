{
  "name": "chordviewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "services/api",
    "contracts"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run build -w @chordviewer/contracts && concurrently --kill-others --names Contract,Web \"tsc -p contracts/tsconfig.json --watch --preserveWatchOutput\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @chordviewer/web",
    "dev:api": "npm run dev -w @chordviewer/api",
    "build": "npm run build -w @chordviewer/contracts && npm run build -w @chordviewer/api && npm run build -w @chordviewer/web",
    "test:run": "npm run build -w @chordviewer/contracts && vitest run",
    "test:web": "playwright test",
    "test:api": "node --test --test-concurrency=1 tests/api/storage.test.mjs",
    "test:persistence": "node --test tests/api/persistence.test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
