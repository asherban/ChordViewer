# syntax=docker/dockerfile:1
FROM postgres:18.6-bookworm@sha256:3725f4e2499eef5134592b3b4ab79a543ed7f8e533b05b5b637af926630f6650
# Apply Debian security fixes after the upstream image's build date. The resulting
# release image is recorded by immutable image ID, archived and rehearsed locally.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
