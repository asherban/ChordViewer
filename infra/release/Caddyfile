{
    admin off
    http_port 8080
    https_port 8443
    servers {
        protocols h1 h2
        timeouts {
            read_header 10s
            read_body 20s
            write 30s
            idle 60s
        }
    }
}

(security) {
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=86400"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
}

(api) {
    request_body {
        max_size 1MB
    }
    reverse_proxy api:3000 {
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Proto
        header_up -X-Real-IP
        header_up X-Chordviewer-Client-IP {remote_host}
        header_up X-Chordviewer-Gateway {$GATEWAY_SECRET}
        transport http {
            dial_timeout 5s
            response_header_timeout 20s
        }
    }
}

{$APP_HOST} {
    import /etc/caddy/tls.caddy
    import security
    encode zstd gzip
    handle /api/* {
        import api
    }
    handle /downloads/* {
        forward_auth api:3000 {
            uri /api/v1/me
            header_up -Forwarded
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up X-Chordviewer-Client-IP {remote_host}
            header_up X-Chordviewer-Gateway {$GATEWAY_SECRET}
        }
        root * /srv
        header Cache-Control "private, no-store"
        file_server
    }
    handle /health* {
        respond 404
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}

www.{$APP_HOST} {
    import /etc/caddy/tls.caddy
    import security
    redir https://{$APP_HOST}{uri} 308
}

api.{$APP_HOST} {
    import /etc/caddy/tls.caddy
    import security
    handle /api/* {
        import api
    }
    handle {
        respond 404
    }
}

http://127.0.0.1:8081 {
    bind 127.0.0.1
    respond /ready "ready" 200
}
