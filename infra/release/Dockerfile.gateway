# syntax=docker/dockerfile:1
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY contracts/package.json ./contracts/package.json
COPY services/api/package.json ./services/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --no-audit
COPY contracts/ ./contracts/
COPY apps/web/ ./apps/web/
RUN npm run build -w @chordviewer/contracts && npm run build -w @chordviewer/web -- --mode release

FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS caddy-build
WORKDIR /build
# The published Caddy image still embeds vulnerable Go/x/net versions. Keep the
# reviewed Caddy release and compile its standard modules with patched dependencies.
RUN go mod init chordviewer-caddy && \
    go get github.com/caddyserver/caddy/v2/cmd/caddy@v2.11.7 golang.org/x/net@v0.60.0 && \
    CGO_ENABLED=0 go build -trimpath -o /out/caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
# The gateway listens above 1024; remove the base image's file capability so it
# can execute with an empty capability bounding set.
RUN apk upgrade --no-cache && setcap -r /usr/bin/caddy && addgroup -g 10001 app && adduser -D -u 10001 -G app app && chown -R app:app /data /config
COPY --from=caddy-build /out/caddy /usr/bin/caddy
COPY --from=build /app/apps/web/dist /srv/web
COPY infra/release/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
