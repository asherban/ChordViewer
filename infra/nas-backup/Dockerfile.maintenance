FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY --chmod=0555 restic-linux /usr/local/bin/restic
COPY --chmod=0555 cv-nas-maintenance /usr/local/bin/cv-nas-maintenance
USER 1028:100
ENV GOMAXPROCS=1 GOMEMLIMIT=384MiB
ENTRYPOINT ["/usr/local/bin/cv-nas-maintenance"]
CMD ["maintain"]
