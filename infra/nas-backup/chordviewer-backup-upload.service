[Unit]
Description=Upload and fully verify ChordViewer through append-only NAS HTTPS
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=cvbackup-transfer
Group=cvbackup
UMask=0077
LoadCredential=restic-password:/etc/chordviewer-backup/operational.password
LoadCredential=rest-auth:/etc/chordviewer-backup/rest-auth.json
ExecStart=/usr/bin/python3 /usr/local/lib/chordviewer-backup/production-backup.py upload
TimeoutStartSec=170min
StateDirectory=chordviewer-backup/worker
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/chordviewer-backup/input
ReadWritePaths=/var/lib/chordviewer-backup/worker
InaccessiblePaths=/run/docker.sock /run/containerd /srv/chordviewer
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=100.68.140.104/32 fd7a:115c:a1e0::c838:8c68/128
SystemCallArchitectures=native
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=64
Nice=10

