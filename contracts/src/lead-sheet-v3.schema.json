{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chordviewer.app/schemas/lead-sheet-v3.schema.json",
  "title": "ChordViewer lead sheet version 3",
  "description": "Structured harmony and persistent logical chord identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "keySignature",
    "timeSignature",
    "ticksPerQuarter",
    "measures"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "$ref": "#/definitions/text",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "keySignature": {
      "enum": [
        "C",
        "G",
        "D",
        "A",
        "E",
        "B",
        "F#",
        "C#",
        "F",
        "Bb",
        "Eb",
        "Ab",
        "Db",
        "Gb",
        "Cb",
        "Am",
        "Em",
        "Bm",
        "F#m",
        "C#m",
        "G#m",
        "D#m",
        "A#m",
        "Dm",
        "Gm",
        "Cm",
        "Fm",
        "Bbm",
        "Ebm",
        "Abm"
      ],
      "type": "string"
    },
    "timeSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "minimum": 1,
          "type": "integer",
          "maximum": 12
        },
        "denominator": {
          "enum": [
            2,
            4,
            8
          ],
          "type": "integer"
        }
      }
    },
    "ticksPerQuarter": {
      "type": "integer",
      "const": 480
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/measure"
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11519
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator",
        "dots"
      ],
      "properties": {
        "denominator": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "dots": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 32
              }
            }
          },
          "then": {
            "properties": {
              "dots": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "alter",
        "octave"
      ],
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "C",
            "D",
            "E",
            "F",
            "G",
            "A",
            "B"
          ]
        },
        "alter": {
          "type": "integer",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "octave": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        }
      }
    },
    "chord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offsetTicks",
        "durationTicks",
        "symbol"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "offsetTicks": {
          "$ref": "#/definitions/offset"
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11520
        },
        "symbol": {
          "$ref": "#/definitions/text",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "logicalId": {
          "$ref": "#/definitions/id"
        },
        "definition": {
          "$ref": "#/definitions/chordDefinition"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "offsetTicks",
        "duration",
        "pitch"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "type": "string",
          "const": "note"
        },
        "offsetTicks": {
          "$ref": "#/definitions/offset"
        },
        "duration": {
          "$ref": "#/definitions/duration"
        },
        "pitch": {
          "$ref": "#/definitions/pitch"
        },
        "tieToNext": {
          "type": "boolean"
        }
      }
    },
    "rest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "offsetTicks",
        "duration"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "type": "string",
          "const": "rest"
        },
        "offsetTicks": {
          "$ref": "#/definitions/offset"
        },
        "duration": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chords",
        "melody"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "chords": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/chord"
          }
        },
        "melody": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/note"
              },
              {
                "$ref": "#/definitions/rest"
              }
            ]
          }
        }
      }
    },
    "chordSpelling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "alter"
      ],
      "properties": {
        "step": {
          "enum": [
            "C",
            "D",
            "E",
            "F",
            "G",
            "A",
            "B"
          ]
        },
        "alter": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      }
    },
    "chordDegree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degree",
        "alter"
      ],
      "properties": {
        "degree": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "alter": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      }
    },
    "chordDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tonal",
            "custom",
            "none",
            "polychord"
          ]
        },
        "root": {
          "$ref": "#/definitions/chordSpelling"
        },
        "bass": {
          "$ref": "#/definitions/chordSpelling"
        },
        "family": {
          "enum": [
            "major",
            "minor",
            "diminished",
            "augmented",
            "power",
            "sus2",
            "sus4"
          ]
        },
        "seventh": {
          "enum": [
            "dominant",
            "major",
            "diminished"
          ]
        },
        "extension": {
          "enum": [
            "6",
            "6/9",
            "9",
            "11",
            "13"
          ]
        },
        "additions": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/chordDegree"
          }
        },
        "alterations": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/chordDegree"
          }
        },
        "omissions": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          }
        },
        "tones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          }
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/chordComponent"
          }
        }
      }
    },
    "chordComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tonal",
            "custom"
          ]
        },
        "root": {
          "$ref": "#/definitions/chordSpelling"
        },
        "bass": {
          "$ref": "#/definitions/chordSpelling"
        },
        "family": {
          "enum": [
            "major",
            "minor",
            "diminished",
            "augmented",
            "power",
            "sus2",
            "sus4"
          ]
        },
        "seventh": {
          "enum": [
            "dominant",
            "major",
            "diminished"
          ]
        },
        "extension": {
          "enum": [
            "6",
            "6/9",
            "9",
            "11",
            "13"
          ]
        },
        "additions": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/chordDegree"
          }
        },
        "alterations": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/chordDegree"
          }
        },
        "omissions": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          }
        },
        "tones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          }
        }
      }
    }
  }
}
